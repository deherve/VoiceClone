{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceClone",
  "version": "0.1.7",
  "identifier": "local.voiceclone",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "VoiceClone", "width": 1320, "height": 820, "minWidth": 980, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
